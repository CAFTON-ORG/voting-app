# Supabase project (Settings > API in the Supabase dashboard).
# The publishable/anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key. Server-only — never prefix with NEXT_PUBLIC_, never
# import from a Client Component. Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of email domains (no leading "@") allowed to vote.
# Matched against the authenticated Supabase/Google session email only —
# never a client-submitted value.
ALLOWED_VOTER_DOMAINS=s.ubaguio.edu,e.ubaguio.edu

# Prisma's database connection — a DEDICATED "prisma" Postgres role, not the
# default postgres user. See docs/database-setup.md for the one-time SQL
# that creates this role and why. Never prefix either with NEXT_PUBLIC_.

# Runtime queries (Server Actions/Components): Supabase's transaction
# pooler, port 6543, required for serverless (Vercel functions).
DATABASE_URL="postgres://prisma.<PROJECT-REF>:<PASSWORD>@<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI only (migrate/introspect): session pooler or direct, port 5432.
# The transaction pooler above doesn't support the prepared statements
# migrations need.
DIRECT_URL="postgres://prisma.<PROJECT-REF>:<PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres"

# Optional. Without this, admin-invite emails link back to whatever host
# the invite was actually sent from (see getBaseUrl() in
# src/actions/admin/invitations.ts) - fine day-to-day, but means an invite
# sent while running the dev server links to localhost. Set this to the
# real production domain (e.g. "https://mmsit.cafton.com", no trailing
# slash) so invite links are always correct regardless of where the invite
# was triggered from.
NEXT_PUBLIC_APP_URL=

# Optional — rate limiting for sensitive Server Actions (currently just
# castBallotAction) via Upstash Redis (see src/lib/rate-limit/client.ts).
# Without these, the app runs with no rate limiting at all rather than
# failing to start — this is an abuse-resistance layer, not something vote
# integrity depends on (that's Postgres's own unique constraint). Get a
# free database at upstash.com (REST API, no server to run).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

